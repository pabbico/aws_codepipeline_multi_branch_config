{
  "name": "env-aware-react-app",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "build": "react-scripts build",
    "dev-build": "REACT_APP_ENV=dev npm run build",
    "stage-build": "REACT_APP_ENV=staging npm run build",
    "prod-build": "REACT_APP_ENV=prod npm run build",
    "development-build": "REACT_APP_ENV=dev npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
